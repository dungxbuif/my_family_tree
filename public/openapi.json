  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Create and revoke a user-bound key in Account → API keys."
      }
    },
    "parameters": {
      "familyTreeId": {
        "in": "query",
        "name": "familyTreeId",
        "required": true,
        "schema": {"type":"string","minLength":36,"maxLength":36,"pattern":"^[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$"},
        "description": "Selected tree ID returned by list_family_trees."
      },
      "id": {"in":"path","name":"id","required":true,"schema":{"type":"string","minLength":36,"maxLength":36,"pattern":"^[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$"}},
      "limit": {"in":"query","name":"limit","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},
      "offset": {
        "in": "query",
        "name": "offset",
        "schema": {"type":"integer","minimum":0,"maximum":2147483647,"default":0}
      }
    },
    "schemas": {
      "edgeCreate": {
        "type": "object",
        "properties": {
          "person_a": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$"
          },
          "person_b": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$"
          },
          "type": {"type":"string","enum":["marriage","biological_child","adopted_child"]},
          "note": {"anyOf":[{"type":"string","maxLength":8192,"pattern":"^[^\\0]*$"},{"type":"null"}]}
        },
        "required": ["person_a","person_b","type"],
        "additionalProperties": false
      },
      "eventCreate": {
        "type": "object",
        "properties": {
          "name": {"type":"string","minLength":1,"maxLength":500,"pattern":"^[^\\0]*$"},
          "event_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "location": {"anyOf":[{"type":"string","maxLength":500,"pattern":"^[^\\0]*$"},{"type":"null"}]},
          "content": {"anyOf":[{"type":"string","maxLength":8192,"pattern":"^[^\\0]*$"},{"type":"null"}]}
        },
        "required": ["name","event_date"],
        "additionalProperties": false
      },
      "eventUpdate": {
        "type": "object",
        "properties": {
          "name": {"type":"string","minLength":1,"maxLength":500,"pattern":"^[^\\0]*$"},
          "event_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "location": {"anyOf":[{"type":"string","maxLength":500,"pattern":"^[^\\0]*$"},{"type":"null"}]},
          "content": {"anyOf":[{"type":"string","maxLength":8192,"pattern":"^[^\\0]*$"},{"type":"null"}]}
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "galleryCreate": {
        "type": "object",
        "properties": {
          "title": {"type":"string","minLength":1,"maxLength":500,"pattern":"^[^\\0]*$"},
          "image_url": {
            "type": "string",
            "maxLength": 2048,
            "allOf": [{"pattern":"^[^\\0]*$"},{"pattern":"^\\/api\\/storage\\/.*"}]
          },
          "description": {"anyOf":[{"type":"string","maxLength":8192,"pattern":"^[^\\0]*$"},{"type":"null"}]},
          "event_date": {
            "anyOf": [
              {
                "type": "string",
