# -----------------------------------------------------------------------------
# PERSONAL FAMILY TREE - ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to ".env.local"
# 2. Fill in the values for your local environment

# The name of the site displayed in the UI
SITE_NAME="My Family Tree"

# PostgreSQL connection string
# Example: postgres://user:password@localhost:5432/family_tree
DATABASE_URL="postgres://postgres:postgres@localhost:55432/family_tree"

# Directory for file uploads (avatars, gallery)
# Defaults to "./uploads" in the project root if not set
UPLOAD_DIR="./uploads"

# Optional: Port for the Next.js app (default: 3000)
# PORT=3000
