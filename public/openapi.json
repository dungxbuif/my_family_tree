{
  "openapi": "3.1.0",
  "info": {
    "title": "Gia Phả Family Tree API",
    "version": "1.0.0",
    "description": "Send a user-owned Bearer key over HTTPS. Each request checks current account and tree access. Send the selected familyTreeId on all family data requests. Private person fields require the owner role and private scope in addition to read or write. Lists default to 50 rows, up to 100 per page. JSON request bodies are limited to 64 KiB. The serialized data envelope is limited to 1 MiB. Responses over the limit return INVALID_INPUT."
  },
  "servers": [{"url":"/","description":"Use this service's HTTPS origin."}],
  "security": [{"bearerAuth":[]}],
  "paths": {
    "/api/v1/family-trees": {
      "get": {
        "operationId": "list_family_trees",
        "summary": "List accessible, unarchived trees",
        "x-required-scopes": ["read"],
        "x-tree-roles": ["owner","editor","viewer"],
        "parameters": [{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/offset"}],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"data":{"type":"array","items":{"$ref":"#/components/schemas/Tree"},"maxItems":100}},
                  "required": ["data"]
                }
              }
            }
          },
          "400": {"$ref":"#/components/responses/Error400"},
          "401": {"$ref":"#/components/responses/Error401"},
          "403": {"$ref":"#/components/responses/Error403"},
          "500": {"$ref":"#/components/responses/Error500"}
        }
      }
    },
