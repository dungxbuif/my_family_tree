# Copy to ~/production/family-tree/.env and replace all placeholder values.
FAMILY_TREE_IMAGE=homelab/family-tree:local
FAMILY_TREE_PORT=18085
SITE_NAME=My Family Tree

# PostgreSQL database dedicated to Family Tree on Pi5.
DATABASE_URL=postgres://family_tree_app:CHANGE_ME@10.10.0.5:5432/family_tree

# Persistent Mac mini directory; never place uploads inside the container layer.
UPLOAD_DIR=/Users/dungxbuif/production/family-tree/uploads

# Private RustFS bucket used for avatars and gallery images.
S3_ENDPOINT=https://storage.dungxbuif.com
S3_BUCKET=mac-ocr
S3_PREFIX=family-tree
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
