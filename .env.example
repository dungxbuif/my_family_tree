# -----------------------------------------------------------------------------
# PERSONAL FAMILY TREE - ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to ".env.local"
# 2. Fill in the values for your local environment

# The name of the site displayed in the UI
SITE_NAME="My Family Tree"

# PostgreSQL connection string
# Example: postgres://user:password@localhost:5432/family_tree
DATABASE_URL="postgres://postgres:postgres@localhost:55432/family_tree"

# Reserved for the legacy local-storage helper. Avatar and gallery routes use S3.
UPLOAD_DIR="./uploads"

# Private S3-compatible object storage (RustFS/MinIO/S3)
# The app uploads with a presigned PUT and serves private objects through
# /api/storage/... so credentials never reach the browser.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_BUCKET="family-tree"
# New private uploads use <prefix>/trees/<tree-id>/<folder>/<file>.
S3_PREFIX="family-tree"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Production Swarm secrets: set file paths instead of direct credential values.
# A configured file takes precedence and must be a readable, non-empty regular file.
# S3_ACCESS_KEY_ID_FILE="/run/secrets/family_tree_s3_access_key_id"
# S3_SECRET_ACCESS_KEY_FILE="/run/secrets/family_tree_s3_secret_access_key"

# Optional: Port for the Next.js app (default: 3000)
# PORT=3000
